&thermal_zones {
	charger_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor5>;
	};

	flash_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor6>;
	};

	wifi_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor7>;
	};

	usb_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor8>;
	};

	board_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor9>;
	};
};

&lk_charger {
	enable_anime;
	/* enable_pe_plus; */
	enable_pd20_reset;
	power_path_support;
	/* Sycamore code for SYCAMORE-24287 by kangkai4 at 20250611 start */
	max_charger_voltage = <14000000>;
	/* Sycamore code for SYCAMORE-24287 by kangkai4 at 20250611 end */
	fast_charge_voltage = <3200000>;

	/* charging current */
	usb_charger_current = <500000>;
	ac_charger_current = <1400000>;
	ac_charger_input_current = <1500000>;
	non_std_ac_charger_current = <500000>;
	charging_host_charger_current = <1500000>;
	ta_ac_charger_current = <3000000>;
	pd_charger_current = <500000>;

	/* battery temperature protection */
	temp_t4_threshold = <50>;
	temp_t3_threshold = <45>;
	temp_t1_threshold = <0>;

	/* enable check vsys voltage */
	enable_check_vsys;
};


&pe {
	gauge = <&mm8013>;
};

&pe2 {
	gauge = <&mm8013>;
};

&pe45 {
	gauge = <&mm8013>;
};

&pe5 {
	gauge = <&mm8013>;
};

&pdc {
	gauge = <&mm8013>;
};

&charger{
	gauge = <&mm8013>;
	charger = <&mt6375_chg>;
	bootmode = <&chosen>;

	algorithm_name = "Basic";
	charger_configuration= <1>;

	/* common */
	battery_cv = <4520000>;
	/* Sycamore code for SYCAMORE-24287 by kangkai4 at 20250611 start */
	max_charger_voltage = <14000000>;
	/* Sycamore code for SYCAMORE-24287 by kangkai4 at 20250611 end */
	min_charger_voltage = <4600000>;

	/* sw jeita */
	enable-vbat-mon = <0>;
	enable_sw_jeita;
	jeita_temp_above_t4_cv = <4200000>;
	jeita_temp_t3_to_t4_cv = <4200000>;
	jeita_temp_t2_to_t3_cv = <4520000>;
	jeita_temp_t1_to_t2_cv = <4520000>;
	jeita_temp_t0_to_t1_cv = <4520000>;
	jeita_temp_below_t0_cv = <4520000>;
	/* Sycamore code for SYCAMORE-15732 by kangkai4 at 20250317 start */
	bc12_low_or_normal_temp_cv = <4490000>;
	/* Sycamore code for SYCAMORE-15732 by kangkai4 at 20250317 end */
	temp_t4_thres = <500>;
	temp_t4_thres_minus_x_degree = <470>;
	temp_t3_thres = <450>;
	temp_t3_thres_minus_x_degree = <1000>;
	temp_t2_thres = <150>;
	temp_t2_thres_plus_x_degree = <0>;
	temp_t1_thres = <0>;
	temp_t1_thres_plus_x_degree = <20>;
	temp_t0_thres = <0>;
	temp_t0_thres_plus_x_degree = <0>;
	temp_neg_10_thres = <0>;

	/* battery temperature protection */
	enable_min_charge_temp;
	min_charge_temp = <0>;
	min_charge_temp_plus_x_degree = <60>;
	max_charge_temp = <500>;
	max_charge_temp_minus_x_degree = <470>;

/* Sycamore code for SYCAMORE-5257 by zhoujj21 at 20250108 start */
/* Sycamore code for SYCAMORE-157 by zhoujj21 at 20241115 start */
	/* charging current */
	usb_charger_current = <500000>;
	ac_charger_current = <1400000>;
	ac_charger_input_current = <2000000>;
	charging_host_charger_current = <1500000>;
	apple_1_0a_charger_current = <1000000>;
	apple_2_1a_charger_current = <2000000>;

	/* lenovo fast-charging current */
	qc_charger_current = <5000000>;
	qc_charger_input_current = <2000000>;
	pd_charger_current = <5000000>;
	pd_charger_input_current = <2250000>;

	/* lenovo jeita ichg */
	jeita_temp_above_t4_ichg = <350000>;
	jeita_temp_t3_to_t4_ichg = <1400000>;
	jeita_temp_t2_to_t3_ichg = <5000000>;
	jeita_temp_t1_to_t2_ichg = <1400000>;
	jeita_temp_t0_to_t1_ichg = <350000>;
	jeita_temp_below_t0_ichg = <0>;

	/* lenovo charging iterm*/
	/* Sycamore code for SYCAMORE-15732 by kangkai4 at 20250317 start */
	bc12_low_temp_iterm_curr = <480000>;
	bc12_normal_temp_iterm_curr = <480000>;
	/* Sycamore code for SYCAMORE-15732 by kangkai4 at 20250317 end */
	high_temp_iterm_curr = <360000>;
	low_temp_iterm_curr = <460000>;
	normal_temp_iterm_curr = <700000>;
/* Sycamore code for SYCAMORE-157 by zhoujj21 at 20241115 end */
/* Sycamore code for SYCAMORE-5257 by zhoujj21 at 20250108 end */

	/* dynamic mivr */
	enable_dynamic_mivr;
	min_charger_voltage_0 = <4500000>;
	min_charger_voltage_1 = <4400000>;
	min_charger_voltage_2 = <4200000>;
	max_dmivr_charger_current = <1800000>;

	/* fast charging algo support indicator */
	enable_fast_charging_indicator;

	/* Sycamore code for SYCAMORE-219 by kangkai4 at 20241118 start */
	/* usb mos ctrl  gpio*/
	usb,ctrl-gpio = <&pio 46 0>;
	/* Sycamore code for SYCAMORE-219 by kangkai4 at 20241118 end */

	/* ScreenON thermal mitigation */
	battery,thermal-mitigation = <5000000 2000000 1400000 1200000 1000000 500000>;
	/* ScreenOFF thermal mitigation */
	battery,thermal-mitigation-screen-off = <5000000 1000000 500000>;
};

&mtk_gauge {
	DISABLE_MTKBATTERY = <1>;
	status = "disabled";
};

&i2c3 {

	clock-frequency = <400000>;
	status = "okay";

	mm8013: mm8013@55 {
		compatible = "mediatek,mm8013";
		reg = <0x55>;
		status = "okay";
/* Sycamore code for SYCAMORE-5024 by zhoujj21 at 20241231 start */
		io-channels = <&pmic_adc AUXADC_BAT_TEMP>;
		io-channel-names = "pmic_battery_temp";
/* Sycamore code for SYCAMORE-5024 by zhoujj21 at 20241231 end */
	};

	sgm4154x: sgm4154x@1A {
		status = "okay";
		compatible = "sgm,sgm41543";
		reg = <0x1A>;
		interrupt-parent = <&pio>;
		interrupts = <0 0>;            //irq num base on hardware design
		sgm,irq-gpio = <&pio 3 0>;     //irq num base on hardware design
		//sgm,chg-en-gpio = <&pio 0 0>;   //gpio num base on hardware design  1.MTK parent node name is pio  2.QUALCOMM parent node name is tlmm or other
		input-voltage-limit-microvolt = <5000000>;
		input-current-limit-microamp = <3000000>;
		io-channels = <&pmic_adc AUXADC_VCDT>;
		io-channel-names = "pmic_vbus";
		phys = <&u2port0 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";
	};

	sc8960x_charger: sc8960x@6B {
		compatible = "southchip,sc89601d";
		reg = <0x6B>;
		status = "okay";
		sc8960x,intr-gpio = <&pio 3 IRQ_TYPE_EDGE_FALLING>;

		sc8960x,charger_name = "primary_chg";
		sc8960x,pfm-dis = <0>; /*0: enable, 1: disable*/
		sc8960x,vsys-min = <5>; /*0: 2.6V, 1: 2.8V, 2: 3.0V,
					3: 3.2V, 4: 3.4V, 5: 3.5V, 6:3.6V, 7: 3.7V*/
		sc8960x,vbat-low-otg = <0>; /*0: 2.8V, 1: 2.5V*/
		sc8960x,ipre-chg = <2>; /*60 + val * 60, unit:mA*/
		sc8960x,itermination = <2>; /*60 + val * 60, unit:mA*/
		sc8960x,vbat-volt = <44>; /*3848 + val * 8, unit:mV*/
		sc8960x,top-off-timer = <0>; /*0: dis, 1: 15min, 2: 20min 3: 45min*/
		sc8960x,vrechg-volt = <1>; /*0: 100mV, 1: 200mV*/
		sc8960x,en-termination = <1>; /*0: disable, 1: enable*/
		sc8960x,wdt-timer = <0>; /*0: disable, 1: 40s, 2: 80s, 3：160s*/
		sc8960x,en-chg-saft-timer = <0>; /*0: disable, 1: enable*/
		sc8960x,charge-timer = <1>; /*0: 5hrs, 1: 10hrs*/
		sc8960x,vac-ovp = <3>; /*0: 5.8V, 1: 6.4V, 2: 11V, 3: 14.2V*/
		sc8960x,iboost = <1>; /*0: 0.5A, 1: 1.2A*/
		sc8960x,vboost = <12>; /*3900 + val * 100, unit:mV*/
		sc8960x,vindpm-track = <0>; /*0: disable, 1:200mV, 2:250mV, 3:300mV*/
		sc8960x,vindpm-int-mask = <1>; /*0: not mask, 1: mask*/
		sc8960x,iindpm-int-mask = <1>; /*0: not mask, 1: mask*/
		sc8960x,vpre-to-cc = <0>; /*0: 3V, 1: 2.8V*/
		sc8960x,auto-dpdm-en = <0>; /*0: disale, 1: enable*/
		sc8960x,ntc-pin-dis = <1>; /*0: enable, 1: disable*/
		io-channels = <&pmic_adc AUXADC_VCDT>;
		io-channel-names = "pmic_vbus";
		phys = <&u2port0 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";
	};

 };

&pio {
	i2c0_mode_default: i2c0_mode_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO127__FUNC_SCL0>,
			<PINMUX_GPIO128__FUNC_SDA0>;
			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
		};
	};
};

 &i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_mode_default>;
	clock-frequency = <400000>;
	status = "okay";

	sgm4154x_slave: sgm4154x@1A {
		status = "okay";
		compatible = "sgm,sgm41543_slave";
		reg = <0x1A>;
		interrupt-parent = <&pio>;
		interrupts = <0 0>;            //irq num base on hardware design
		//sgm,irq-gpio = <&pio 2 0>;     //irq num base on hardware design
		//sgm,chg-en-gpio = <&pio 0 0>;   //gpio num base on hardware design  1.MTK parent node name is pio  2.QUALCOMM parent node name is tlmm or other
		input-voltage-limit-microvolt = <5000000>;
		input-current-limit-microamp = <3000000>;
	};

	sc8960x_charger_slave: sc8960x@6B {
		compatible = "southchip,sc89601d_slave";
		reg = <0x6B>;
		status = "okay";
		//sc8960x,intr-gpio = <&pio 2 IRQ_TYPE_EDGE_FALLING>;

		sc8960x,charger_name = "secondary_chg";
		sc8960x,pfm-dis = <0>; /*0: enable, 1: disable*/
		sc8960x,vsys-min = <5>; /*0: 2.6V, 1: 2.8V, 2: 3.0V,
					3: 3.2V, 4: 3.4V, 5: 3.5V, 6:3.6V, 7: 3.7V*/
		sc8960x,vbat-low-otg = <0>; /*0: 2.8V, 1: 2.5V*/
		sc8960x,ipre-chg = <2>; /*60 + val * 60, unit:mA*/
		sc8960x,itermination = <2>; /*60 + val * 60, unit:mA*/
		sc8960x,vbat-volt = <44>; /*3848 + val * 8, unit:mV*/
		sc8960x,top-off-timer = <0>; /*0: dis, 1: 15min, 2: 20min 3: 45min*/
		sc8960x,vrechg-volt = <0>; /*0: 100mV, 1: 200mV*/
		sc8960x,en-termination = <1>; /*0: disable, 1: enable*/
		sc8960x,wdt-timer = <0>; /*0: disable, 1: 40s, 2: 80s, 3：160s*/
		sc8960x,en-chg-saft-timer = <0>; /*0: disable, 1: enable*/
		sc8960x,charge-timer = <1>; /*0: 5hrs, 1: 10hrs*/
		sc8960x,vac-ovp = <3>; /*0: 5.8V, 1: 6.4V, 2: 11V, 3: 14.2V*/
		sc8960x,iboost = <1>; /*0: 0.5A, 1: 1.2A*/
		sc8960x,vboost = <12>; /*3900 + val * 100, unit:mV*/
		sc8960x,vindpm-track = <0>; /*0: disable, 1:200mV, 2:250mV, 3:300mV*/
		sc8960x,vindpm-int-mask = <1>; /*0: not mask, 1: mask*/
		sc8960x,iindpm-int-mask = <1>; /*0: not mask, 1: mask*/
		sc8960x,vpre-to-cc = <0>; /*0: 3V, 1: 2.8V*/
		sc8960x,auto-dpdm-en = <0>; /*0: disale, 1: enable*/
		sc8960x,ntc-pin-dis = <1>; /*0: enable, 1: disable*/
	};

 };

&i2c7 {

	clock-frequency = <1000000>;
	status = "okay";

	wusb3812_typec: type_c_port0@20 {
		reg = <0x20>;
		compatible = "mediatek,usb_type_c";
		status = "okay";
		ws-tcpc,name = "type_c_port0";
		wusb3812pd,intr_gpio_num = <12>;
		wusb3812pd,intr_gpio = <&pio 12 0x0>;
		ws-tcpc,role_def = <5>;
		ws-tcpc,rp_level = <0>;
		ws-tcpc,vconn_supply  = <0>;

		ws-tcpc,notifier_supply_num = <3>;

		pd-data {
			pd,vid = <0x34D0>;
			pd,pid = <0x0401>;
			pd,source-cap-ext = <0x7610362f 0x00000000 0x00000000
							0x00000000 0x00000000 0x02000000 >;
			pd,mfrs = "RichtekTCPC";
			pd,charging_policy= <0x31>;

			pd,source-pdo-size = <1>;
			pd,source-pdo-data = <0x00019032>;

			pd,sink-pdo-size = <2>;
			pd,sink-pdo-data = <0x000190c8 0x0002d0e1> ; //5V,2A 9V,2.25A
			pd,id-vdo-size = <6>;
			pd,id-vdo-data = <0xd140362f 0x0 0x76100000
					  0x41800000 0x0 0x21800000>;
			bat,nr = <1>;
			pd,country_nr = <0>;

			bat-info0 {
				bat,vid = <0x34D0>;
				bat,pid = <0x0401>;
				bat,mfrs = "bat1";
				bat,design_cap = <5000>;
			};
		};
		dpm_caps {
			local_dr_power;
			local_dr_data;
			local_usb_comm;
			local_vconn_supply;
			attemp_enter_dp_mode;
			attemp_discover_cable;
			attemp_discover_id;
			pr_check = <0>;
			dr_check = <0>;
		};
		displayport {
			/* connection type = "both", "ufp_d", "dfp_d" */
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			//signal,dp_gen2;
			//usbr20_not_used;
			typec,receptacle;
			ufp_d {
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				//pin_assignment,mode_c;
				//pin_assignment,mode_d;
				//pin_assignment,mode_e;
			};
			dfp_d {
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
				//pin_assignment,mode_f;
			};
		};
	};

};

&i2c7 {
	clock-frequency = <1000000>;
	status = "okay";

		upm7610pd: upm7610pd@60{
			compatible = "up,upm7610";
			reg = <0x60>;
			status = "okay";
			rt-tcpc,name = "type_c_port0"; /* tcpc_device's name */
			rt-tcpc,role_def = <5>; /* 0: Unknown, 1: SNK, 2: SRC */
						/* 3: DRP, 4: Try.SRC, 5: Try.SNK */
			rt-tcpc,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
			rt-tcpc,vconn_supply  = <1>;  /* 0: Never, 1: Always, */
							/* 2: EMarkOnly, 3: StartOnly */
			rt-tcpc,notifier_supply_num = <3>;
			upm7610pd,intr_gpio = <&pio 12 0>;
			upm7610pd,intr_gpio_num = <12>;
			pd-data {
				pd,vid = <0x362f>;
				pd,pid = <0x7610>;
				pd,source-cap-ext = <0x7610362f 0x00000000 0x00000000
							0x00000000 0x00000000 0x02000000>;
				pd,mfrs = "UnisemipowerTCPC";

				/*
				*	VSAFE5V = 0, MAX_POWER = 1, CUSTOM = 2,
				*	MAX_POWER_LV = 0x21, MAX_POWER_LVIC = 0x31
				*	MAX_POWER_HV = 0x41, MAX_POWER_HVIC = 0x51
				*/
				pd,charging_policy= <0x31>;

				/*
				* Fixed 5V, 500 mA <0x00019032>
				* Fixed 5V, 1A <0x00019064>
				* Fixed 5V, 2A <0x000190c8>
				* Fixed 5V, 3A <0x0001912c>
				* Fixed 9V, 500 mA <0x0002d032>
				* Fixed 9V, 1A <0x0002d064>
				* Fixed 9V, 2A <0x0002d0c8>
				* Fixed 9V, 3A <0x0002d12c>
				* Variable 5-9V, 1A <0x8642d064>
				* Variable 5-9V, 2A <0x8642d0c8>
				* Variable 5-9V, 3A <0x8642d12c>
				* PPS 3V~5.9V, 3A <0xC0761E3C>
				*/
				pd,source-pdo-size = <1>;
				pd,source-pdo-data = <0x00019032>;
				pd,sink-pdo-size = <2>;
				pd,sink-pdo-data = <0x000190c8 0x0002d0e1 >; //5V,2A 9V,2.25A

				/*
				* No DP, host + device
				*	pd,id-vdo-size = <6>;
				*	pd,id-vdo-data = <0xd14029cf 0x0 0x17110000
							0x41800000 0x0 0x21800000>;
				* With DP
				*	pd,id-vdo-size = <6>;
				*	pd,id-vdo-data = <0xd54029cf 0x0 0x17110000
							0x41800000 0x0 0x21800000>;
				*/

				pd,id-vdo-size = <6>;
				pd,id-vdo-data = <0xd140362f 0x0 0x76100000
						0x41800000 0x0 0x21800000>;

				bat,nr = <1>;
				pd,country_nr = <0>;

				bat-info0 {
					bat,vid = <0x362f>;
					bat,pid = <0x7610>;
					bat,mfrs = "bat1";
					bat,design_cap = <5000>;
				};

				//bat-info1 {
				//	bat,vid = <0x8abc>;
				//	bat,pid = <0x5234>;
				//	bat,mfrs = "bat2";
				//	bat,design_cap = <4000>;
				//};

				//country0 {
				//	pd,country_code = <0x5457>;
				//	pd,country_len = <2>; /* max len = 26 */
				//	pd,country_data = <0xff 0xff>;
				//};

				//country1 {
				//	pd,country_code = <0x5553>;
				//	pd,country_len = <3>; /* max len = 26 */
				//	pd,country_data = <0xf1 0xf2 0xf3>;
				//};
			};
			dpm_caps {
				local_dr_power;
				local_dr_data;
				//local_ext_power;
				local_usb_comm;
				//local_usb_suspend;
				//local_high_cap;
				//local_give_back;
				local_no_suspend;
				local_vconn_supply;

				//attemp_discover_cable_dfp;
				attemp_enter_dp_mode;
				attemp_discover_cable;
				attemp_discover_id;

				/* 0: disable, 1: prefer_snk, 2: prefer_src */
				pr_check = <0>;
				//pr_reject_as_source;
				//pr_reject_as_sink;
				//pr_check_gp_source;
				//pr_check_gp_sink;

				/* 0: disable, 1: prefer_ufp, 2: prefer_dfp */
				dr_check = <0>;
				//dr_reject_as_dfp;
				//dr_reject_as_ufp;
			};
			displayport {
				/* connection type = "both", "ufp_d", "dfp_d" */
				1st_connection = "dfp_d";
				2nd_connection = "dfp_d";
				signal,dp_v13;
				//signal,dp_gen2;
				//usbr20_not_used;
				typec,receptacle;
				ufp_d {
					//pin_assignment,mode_a;
					//pin_assignment,mode_b;
					//pin_assignment,mode_c;
					//pin_assignment,mode_d;
					//pin_assignment,mode_e;
				};
				dfp_d {
					//pin_assignment,mode_a;
					//pin_assignment,mode_b;
					pin_assignment,mode_c;
					pin_assignment,mode_d;
					pin_assignment,mode_e;
					//pin_assignment,mode_f;
				};
			};
		};

};

