&pio {
	ctp_nt36523n_hx83102j_pins_default: pins_default {
	};
	ctp_nt36523n_hx83102j_spi_clk_mode: spi_clk {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO68__FUNC_SPI3_CLK>;
			output-low;
			drive-strength = <4>;
		};
	};
	ctp_nt36523n_hx83102j_spi_csb_mode: spi_csb {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO69__FUNC_SPI3_CSB>;
			output-high;
			drive-strength = <4>;
		};
	};
	ctp_nt36523n_hx83102j_spi_mo_mode: spi_mo {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO70__FUNC_SPI3_MO>;
			output-high;
			drive-strength = <4>;
		};
	};
	ctp_nt36523n_hx83102j_spi_mi_mode: spi_mi {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO71__FUNC_SPI3_MI>;
			input-enable;
			drive-strength = <4>;
		};
	};

	ctp_nt36523n_hx83102j_spi_suspend: spi_suspend {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO68__FUNC_GPIO68>,
				<PINMUX_GPIO69__FUNC_GPIO69>,
				<PINMUX_GPIO70__FUNC_GPIO70>,
				<PINMUX_GPIO71__FUNC_GPIO71>;
			input-disable;
			bias-disable;
			output-low;
		};
	};
};