/* CAMERA GPIO standardization */
&pio {
	camera_pins_cam0_rst_0: cam0@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO26__FUNC_GPIO26>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam0_rst_1: cam0@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO26__FUNC_GPIO26>;
			slew-rate = <1>;
			output-high;
		};
	};
	camera_pins_cam1_rst_0: cam1@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO27__FUNC_GPIO27>;
			slew-rate = <1>;
			output-low;
		};
	};
	camera_pins_cam1_rst_1: cam1@3 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO27__FUNC_GPIO27>;
			slew-rate = <1>;
			output-high;
		};
	};
	camera_pins_cam0_mclk_off: camera_pins_cam0_mclk_off {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO89__FUNC_GPIO89>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam0_mclk_2ma: camera_pins_cam0_mclk_2ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO89__FUNC_CMMCLK1>;
			drive-strength = <0>;
		};
	};
	camera_pins_cam0_mclk_4ma: camera_pins_cam0_mclk_4ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO89__FUNC_CMMCLK1>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam0_mclk_6ma: camera_pins_cam0_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO89__FUNC_CMMCLK1>;
			drive-strength = <2>;
		};
	};
	camera_pins_cam0_mclk_8ma: camera_pins_cam0_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO89__FUNC_CMMCLK1>;
			drive-strength = <3>;
		};
	};
	camera_pins_cam1_mclk_off: camera_pins_cam1_mclk_off {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO90__FUNC_GPIO90>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam1_mclk_2ma: camera_pins_cam1_mclk_2ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO90__FUNC_CMMCLK2>;
			drive-strength = <0>;
		};
	};
	camera_pins_cam1_mclk_4ma: camera_pins_cam1_mclk_4ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO90__FUNC_CMMCLK2>;
			drive-strength = <1>;
		};
	};
	camera_pins_cam1_mclk_6ma: camera_pins_cam1_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO90__FUNC_CMMCLK2>;
			drive-strength = <2>;
		};
	};
	camera_pins_cam1_mclk_8ma: camera_pins_cam1_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO90__FUNC_CMMCLK2>;
			drive-strength = <3>;
		};
	};

	camera_flashlight_pwm_148: camera_flashlight_pwm@gpio148 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO148__FUNC_PWM_1>;
			output-high;
		};
	};
	camera_flashlight_pwm_171: camera_flashlight_pwm@gpio171 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO171__FUNC_PWM_AO>;
			output-high;
		};
	};
	camera_flashlight_gpio_low_171: camera_flashlight_gpio_low@gpio171 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO171__FUNC_GPIO171>;
			output-low;
		};
	};
	camera_flashlight_gpio_high_171: camera_flashlight_gpio_high@gpio171 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO171__FUNC_GPIO171>;
			output-high;
		};
	};
	camera_flashlight_gpio_low_148: camera_flashlight_gpio_low@gpio148 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO148__FUNC_GPIO148>;
			output-low;
		};
	};
	camera_flashlight_gpio_high_148: camera_flashlight_gpio_high@gpio148 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO148__FUNC_GPIO148>;
			output-high;
		};
	};
	camera_flashlight_pwm_147: camera_flashlight_pwm@gpio147 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO147__FUNC_PWM_0>;
			output-high;
		};
	};
	camera_flashlight_gpio_low_147: camera_flashlight_gpio_low@gpio147 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO147__FUNC_GPIO147>;
			output-low;
		};
	};
	camera_flashlight_gpio_high_147: camera_flashlight_gpio_high@gpio147 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO147__FUNC_GPIO147>;
			output-high;
		};
	};

	camera_pins_default: camdefault {
	};
};
&kd_camera_hw1 {
	pinctrl-names = "default",
			"cam0_rst0", "cam0_rst1",
			"cam1_rst0", "cam1_rst1",
			"cam2_rst0", "cam2_rst1",
			"cam0_mclk_off",
			"cam0_mclk_2mA", "cam0_mclk_4mA",
			"cam0_mclk_6mA", "cam0_mclk_8mA",
			"cam1_mclk_off",
			"cam1_mclk_2mA", "cam1_mclk_4mA",
			"cam1_mclk_6mA", "cam1_mclk_8mA",
			"cam2_mclk_off",
			"cam2_mclk_2mA", "cam2_mclk_4mA",
			"cam2_mclk_6mA", "cam2_mclk_8mA",
			"cam0_avdd1_gpio_0",  "cam0_avdd1_gpio_1";

	pinctrl-0 = <&camera_pins_default>;
	pinctrl-1 = <&camera_pins_cam0_rst_0>;
	pinctrl-2 = <&camera_pins_cam0_rst_1>;
	pinctrl-3 = <&camera_pins_cam1_rst_0>;
	pinctrl-4 = <&camera_pins_cam1_rst_1>;
	pinctrl-5 = <&camera_pins_cam0_mclk_off>;
	pinctrl-6 = <&camera_pins_cam0_mclk_2ma>;
	pinctrl-7 = <&camera_pins_cam0_mclk_4ma>;
	pinctrl-8 = <&camera_pins_cam0_mclk_6ma>;
	pinctrl-9 = <&camera_pins_cam0_mclk_8ma>;
	pinctrl-10 = <&camera_pins_cam1_mclk_off>;
	pinctrl-11 = <&camera_pins_cam1_mclk_2ma>;
	pinctrl-12 = <&camera_pins_cam1_mclk_4ma>;
	pinctrl-13 = <&camera_pins_cam1_mclk_6ma>;
	pinctrl-14 = <&camera_pins_cam1_mclk_8ma>;

	/* main (wide)*/
	cam0_vcama-supply = <&mt6377_vfp>;
	cam0_vcamd-supply = <&mt6377_vio28>;
	cam0_vcamio-supply = <&mt6377_vaud18>;
	cam0_vcamaf-supply = <&mt6377_vibr>;

	cam0_pin_mclk = "mclk";
	cam0_pin_rst = "gpio";
	cam0_pin_vcama = "regulator";
	cam0_pin_vcamio = "regulator";
	cam0_pin_vcamd = "regulator";
	cam0_pin_vcamaf = "regulator";
	cam0_enable_sensor = "sc820acs_sunwin_rear_mipi_raw   ov13b10_txd_rear_mipi_raw  gc13a0_lce_rear_mipi_raw   gc08a8_ofilm_rear_mipi_raw ";


	/* front*/
    cam1_vcama-supply = <&mt6377_vfp>;
	cam1_vcamd-supply = <&mt6377_vio28>;
	cam1_vcamio-supply = <&mt6377_vaud18>;

	cam1_pin_mclk = "mclk";
	cam1_pin_rst = "gpio";
	cam1_pin_vcama = "regulator";
	cam1_pin_vcamio = "regulator";
	cam1_pin_vcamd = "regulator";
	cam1_enable_sensor = " sc820cs_txd_front_mipi_raw gc05a2_lce_front_mipi_raw sc520cs_sunwin_front_mipi_raw  gc08a8_sunwin_front_mipi_raw";

	status = "okay";
};
/* CAMERA GPIO end */

/* CAMERA EEPROM */
&i2c8 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	mtk_camera_eeprom0:camera_eeprom0@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};
	camera_main_mtk:camera_main@1a {
		compatible = "mediatek,camera_main";
		#thermal-sensor-cells = <0>;
		reg = <0x1a>;
		status = "okay";
	};

	camera_main_af_mtk:camera_main_af@18 {
		compatible = "mediatek,camera_main_af";
		reg = <0x18>;
		status = "okay";
	};
};

&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	mtk_camera_eeprom1:camera_eeprom1@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};
	camera_sub_mtk:camera_sub@1a {
		compatible = "mediatek,camera_sub";
		#thermal-sensor-cells = <0>;
		reg = <0x1a>;
		status = "okay";
	};
};
/* CAMERA EEPROM end */

/* CAMERA AF */


&camera_af_hw_node {
	camaf_m1_pmic-supply = <&mt6377_vibr>;
	status = "okay";
};
/* CAMERA AF end */

&aw3641e {
pinctrl-names = "default",
				"gpio_low_171",
				"gpio_high_171",
				"output_pwm_171",
				"gpio_low_148",
				"gpio_high_148",
				"output_pwm_148",
				"gpio_low_147",
				"gpio_high_147",
				"output_pwm_147";
pinctrl-0 = <&camera_flashlight_gpio_low_171>;
pinctrl-1 = <&camera_flashlight_gpio_low_171>;
pinctrl-2 = <&camera_flashlight_gpio_high_171>;
pinctrl-3 = <&camera_flashlight_pwm_171>;
pinctrl-4 = <&camera_flashlight_gpio_low_148>;
pinctrl-5 = <&camera_flashlight_gpio_high_148>;
pinctrl-6 = <&camera_flashlight_pwm_148>;
pinctrl-7 = <&camera_flashlight_gpio_low_147>;
pinctrl-8 = <&camera_flashlight_gpio_high_147>;
pinctrl-9 = <&camera_flashlight_pwm_147>;
};
